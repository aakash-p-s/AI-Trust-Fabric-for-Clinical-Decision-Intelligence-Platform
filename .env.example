DATABASE_URL=postgresql://trust_fabric:trust_fabric_dev_password@localhost:5432/trust_fabric
# No Docker / no Postgres available? Use SQLite instead:
# DATABASE_URL=sqlite:///./trust_fabric.db

OPENROUTER_API_KEY=sk-or-your-key-here
EXPLAINABILITY_MODEL=openai/gpt-oss-20b:free
TRUST_MONITORING_INTERVAL_HOURS=6
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- AI Governance Assistant (chatbot) -- Groq, separate from OpenRouter ---
GROQ_API_KEY=gsk-your-key-here
CHAT_ASSISTANT_MODEL=openai/gpt-oss-120b
